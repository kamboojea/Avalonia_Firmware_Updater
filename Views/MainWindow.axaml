                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Height="10"
                                                 Foreground="#0B6F66"
                                                 Background="Transparent" />
                                    <Border x:Name="ProgressPulse"
                                            Classes="progressPulse"
                                            HorizontalAlignment="Left">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-140" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
