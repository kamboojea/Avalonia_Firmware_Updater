                                       Grid.Row="0"
                                       Grid.Column="2"
                                       Text="0%"
                                       Foreground="#17211C"
                                       FontWeight="SemiBold" />
                            <Border x:Name="ProgressPulseHost"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Classes="progressTrack">
